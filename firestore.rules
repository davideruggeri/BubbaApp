rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          getUserDoc().data.get('role', '') == 'amministratore' ||
          getUserDoc().data.get('ruolo_globale', '') == 'amministratore'
        );
    }

    function isStaff() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          isAdmin() ||
          getUserDoc().data.get('role', '') == 'staff' ||
          getUserDoc().data.get('ruolo_globale', '') == 'staff'
        );
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // Stagione corrente - solo admin può cambiare
    match /impostazione/stagione_corrente {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Campi del profilo che solo un amministratore può impostare o modificare
    function protectedUserFields() {
      return ['role', 'ruolo_globale', 'isDisabled', 'memberId'];
    }

    // Alla registrazione l'utente può creare solo un profilo base (ruolo "Bubba" o nessun ruolo)
    function isValidNewProfile() {
      let data = request.resource.data;
      return data.get('role', null) in ['Bubba', null]
        && !data.keys().hasAny(['ruolo_globale'])
        && data.get('memberId', null) == null
        && data.get('isDisabled', false) == false;
    }

    // L'utente può modificare il proprio profilo, ma non ruolo, stato o collegamento al membro
    function changesOnlyOwnFields() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(protectedUserFields());
    }

    // Profili utente: tutti gli autenticati leggono; ognuno modifica i propri dati base;
    // ruoli, disattivazione e collegamento al membro solo da admin
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) && isValidNewProfile();
      allow update: if isAdmin() || (isOwner(userId) && changesOnlyOwnFields());
      allow delete: if isAdmin();
    }

    // Membri della squadra (indirizzario): tutti autenticati leggono; solo staff/admin scrivono
    match /indirizzario/{memberId} {
      allow read: if isAuthenticated();
      allow write: if isStaff();
    }
    match /members/{memberId} {
      allow read: if isAuthenticated();
      allow write: if isStaff();
    }

    // Presenze: tutti autenticati leggono; solo staff/admin modificano/eliminano
    match /presenze/{presenceId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isStaff();
    }

    // Calendario eventi (calendario): tutti autenticati leggono; solo staff/admin scrive
    match /calendario/{eventId} {
      allow read: if isAuthenticated();
      allow write: if isStaff();
    }
    match /events/{eventId} {
      allow read: if isAuthenticated();
      allow write: if isStaff();
    }

    // Storico presenze archiviate - solo admin scrive
    match /presenze_history/{season} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Storico stagioni - solo admin scrive
    match /stagioni_storico/{season} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Analisi partite - solo staff/admin scrive
    match /match_analysis/{matchId} {
      allow read: if isAuthenticated();
      allow write: if isStaff();
    }

    // Hall of Fame (albo) - solo staff/admin scrive
    match /albo/{docId} {
      allow read: if isAuthenticated();
      allow write: if isStaff();
    }
    match /hall_of_fame/{docId} {
      allow read: if isAuthenticated();
      allow write: if isStaff();
    }

    // Lega / campionato - solo staff/admin scrive
    match /league/{docId} {
      allow read: if isAuthenticated();
      allow write: if isStaff();
    }
    match /league/{docId}/{subCollection}/{subDocId} {
      allow read: if isAuthenticated();
      allow write: if isStaff();
    }
    match /league_history/{docId} {
      allow read: if isAuthenticated();
      allow write: if isStaff();
    }

    // Roster tornei - solo staff/admin scrive
    match /roster/{docId} {
      allow read: if isAuthenticated();
      allow write: if isStaff();
    }
    match /rosters/{docId} {
      allow read: if isAuthenticated();
      allow write: if isStaff();
    }

    // Bubba Wrapped - solo admin genera; tutti autenticati leggono
    match /wrapped/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    match /wrapped/{docId}/{subCollection}/{subDocId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    match /bubba_wrapped/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    match /bubba_wrapped/{docId}/{subCollection}/{subDocId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Mappa geografica mondiale - solo staff/admin scrive
    match /world_locations/{docId} {
      allow read: if isAuthenticated();
      allow write: if isStaff();
    }

    // Schemi tattici - autenticati leggono e scrivono
    match /tactical_schemes/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Comunicazioni - tutti leggono; solo staff scrive
    match /comunicazioni/{docId} {
      allow read: if isAuthenticated();
      allow write: if isStaff();
    }

    // Impostazioni generali (altre) - solo admin scrive
    match /impostazione/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Default catch-all: solo lettura per autenticati, nessuna scrittura non coperta sopra
    match /{document=**} {
      allow read: if isAuthenticated();
      allow write: if false;
    }
  }
}
