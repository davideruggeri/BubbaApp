{
  "expo": {
    "name": "BubbaApp",
    "slug": "BubbaApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logoBianco.jpeg",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/logoBianco.jpeg",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logoBianco.jpeg",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "navigationBar": {
        "visible": false,
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "favicon": "./assets/logoBianco.jpeg",
      "display": "standalone",
      "startUrl": "/",
      "name": "BubbaApp",
      "shortName": "BubbaApp",
      "themeColor": "#ffffff",
      "backgroundColor": "#ffffff"
    },
    "plugins": [
      "expo-audio",
      "expo-font",
      "expo-asset"
    ]
  }
}
